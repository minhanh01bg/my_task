# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store*/

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.crt
__pycache__/
*.py[cod]
.vscode/
.roo/

# Product images uploaded at runtime
public/uploads/products/*
!public/uploads/products/.gitkeep

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.superpowers/
.worktrees/

# SQLite
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/*.db
/backups/

# anh san pham nguoi dung upload luc chay
/public/uploads/

# ket qua chay test — san pham sinh ra, khong thuoc ve repo
/playwright-report/
/test-results/
/e2e/screenshots/
.crawl/
.omc/

# log của scripts/agent
/.agent-logs/
# ảnh/file người dùng gửi qua bot ccgram
/.ccgram-uploads/
