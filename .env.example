# Database
DATABASE_URL="file:./dev.db"

# Session — chuoi ngau nhien >= 32 ky tu
SESSION_SECRET="thay-bang-chuoi-ngau-nhien-that-dai-32-ky-tu"

# Mat khau cua hang (Mac dinh phat trien: 123456) — sinh bang: pnpm tsx scripts/hash-password.ts <matkhau>
STORE_PASSWORD_HASH="68bb3ab56e351d4e7e72bf8c511d76ab:cf3f01b0fa3356ff68c7d6856efc470e1b1031cb897f22ceed954207f0379db0"

# --- Online Store Security Configuration ---

# Distributed Redis rate limiting (Upstash REST API)
# In production, mandatory for checkout and authentication abuse protection.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Keyed HMAC secret for pseudonymizing rate-limit dimensions (>= 32 chars)
RATE_LIMIT_KEY_SECRET="thay-bang-khoa-pseudonymization-rat-dai-32-ky-tu"

# Trusted proxy resolution mode: 'none' | 'vercel' | 'cloudflare' | 'custom'
# In production, must not be 'none'. If 'custom', specify TRUSTED_CLIENT_IP_HEADER.
TRUSTED_PROXY_MODE="none"
# TRUSTED_CLIENT_IP_HEADER="x-real-ip"

# Canonical public application origin (used for CSRF and Origin header validation)
# In production, must be a valid canonical URL, e.g. https://store.example.com
CANONICAL_ORIGIN="http://localhost:3000"

# Content Security Policy rollout mode: 'report-only' | 'enforce' | 'disabled'
CSP_MODE="report-only"

# Online Store data retention policy in days (default: 90)
DATA_RETENTION_DAYS="90"
