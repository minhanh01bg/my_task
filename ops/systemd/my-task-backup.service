[Unit]
Description=Encrypted SQLite backup to Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ccgram/my_task
ExecStart=/home/ccgram/.nvm/versions/node/v22.23.3/bin/node /home/ccgram/my_task/scripts/backup-db.mjs
UMask=0077
TimeoutStartSec=7min
NoNewPrivileges=true
PrivateTmp=true
